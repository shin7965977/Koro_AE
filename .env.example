# ============================================================
# KoRo Analytics Engineering & AI Platform Configuration
# ============================================================

# Google Cloud & BigQuery Configuration
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET_RAW=koro_raw
BIGQUERY_DATASET_STAGING=koro_staging
BIGQUERY_DATASET_MARTS=koro_marts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Shopware 6 API
SHOPWARE_API_URL=https://your-shopware-instance.com/api
SHOPWARE_ACCESS_KEY_ID=your_access_key
SHOPWARE_SECRET_ACCESS_KEY=your_secret_key

# Scraper Settings
KORO_BASE_URL=https://www.korodrogerie.de
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gemini-1.5-pro

# Streamlit / Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
